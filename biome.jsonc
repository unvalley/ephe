{
  "$schema": "https://next.biomejs.dev/schemas/latest/schema.json",
  "vcs": {
    "useIgnoreFile": true,
    "clientKind": "git",
    "enabled": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "useExhaustiveDependencies": {
          "options": {},
          "level": "off"
        }
      },
      "suspicious": {
        "noDoubleEquals": {
          "level": "error",
          "options": {
            "ignoreNull": true
          }
        }
      },
      "nursery": {
        "useTailwindSortedClasses": {
          "level": "error",
          "fix": "unsafe"
        }
      }
    }
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "tailwind": { "attributes": ["class", "className"], "stylesheet": "./src/globals.css" }
}
