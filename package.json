{
  "name": "ephe",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm run copy:wasm && vite",
    "build": "pnpm run copy:wasm && tsc && vite build",
    "preview": "vite preview",
    "lint": "pnpm lint:biome",
    "lint:biome": "biome lint",
    "lint:biome:write": "biome lint --write --unsafe",
    "format": "biome format --write",
    "copy:wasm": "node --experimental-strip-types src/scripts/copy-wasm.ts",
    "test": "pnpm test:unit",
    "test:unit": "vitest src",
    "test:unit:ui": "vitest src --ui",
    "test:unit:coverage": "vitest src --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "knip": "pnpm dlx knip"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@dprint/formatter": "^0.5.1",
    "@dprint/markdown": "^0.25.0",
    "@headlessui/react": "^2.2.10",
    "@lezer/highlight": "^1.2.5",
    "@phosphor-icons/react": "^2.1.10",
    "cmdk": "^1.1.1",
    "jotai": "^3.0.1",
    "motion": "^14.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "sonner": "^2.0.8",
    "use-debounce": "^10.1.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@biomejs/biome": "latest",
    "@playwright/test": "^1.63.0",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser": "^5.0.3",
    "@vitest/browser-playwright": "^5.0.3",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/ui": "5.0.3",
    "autoprefixer": "^10.6.1",
    "babel-plugin-react-compiler": "1.0.0",
    "postcss": "^8.5.28",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^5.0.3"
  }
